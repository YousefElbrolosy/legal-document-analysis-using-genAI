{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/contractnli-ms2-playbook.schema.json",
  "title": "ContractNLI MS2 Playbook Schema",
  "type": "object",
  "required": [
    "playbook_id",
    "version",
    "global_defaults",
    "criticality_tiers",
    "checks"
  ],
  "properties": {
    "playbook_id": { "type": "string" },
    "version": { "type": "string" },
    "source": { "type": "string" },
    
    "global_defaults": {
      "type": "object",
      "required": ["label_to_status", "label_to_default_decision"],
      "properties": {
        "evidence_required_for": {
          "type": "array",
          "items": { "type": "string" }
        },
        "label_to_status": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["satisfied", "conflict", "missing"] }
        },
        "label_to_default_decision": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["severity", "action"],
            "properties": {
              "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
              "action": { "type": "string", "enum": ["ACCEPT", "CLARIFY", "NEGOTIATE", "ESCALATE"] }
            }
          }
        }
      }
    },
    
    "criticality_tiers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    
    "template_slots": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "title", "hypothesis_text", "criticality", "rationale_templates"],
        "properties": {
          "hypothesis_id": { "type": "string", "pattern": "^H[0-9]{2}$" },
          "title": { "type": "string" },
          "hypothesis_text": { "type": "string" },
          "criticality": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["severity", "action"],
              "properties": {
                "severity": { "type": "string" },
                "action": { "type": "string" }
              }
            }
          },
          "rationale_templates": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "multi_agent_instructions": {
            "type": "string",
            "description": "Specific context guidelines/prompts for the conversation agent to apply for this rule."
          }
        }
      }
    }
  }
}
