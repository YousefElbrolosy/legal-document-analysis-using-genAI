# --- Active provider: OpenAI -------------------------------------------------
MS3_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MS3_MODEL=gpt-4o-mini

# --- Fallback provider: NVIDIA Build (free, OpenAI-compatible) ---------------
# To switch: set MS3_PROVIDER=nvidia and MS3_MODEL=qwen/qwen2.5-72b-instruct
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Fallback provider: Ollama Cloud -----------------------------------------
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# --- Fallback provider: OpenRouter (OpenAI-compatible) -----------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Generation params --------------------------------------------------------
MS3_TEMPERATURE=0.1
MS3_TOP_P=0.9
MS3_MAX_TOKENS=800
