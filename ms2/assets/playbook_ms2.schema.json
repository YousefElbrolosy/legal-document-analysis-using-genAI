{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guc-csen1144.example/schemas/playbook_ms2.schema.json",
  "title": "Milestone 2 NDA Review Playbook Schema",
  "description": "Schema for the updated Milestone 2 playbook that fits the vector RAG, GraphRAG, conversational-agent, and planned 17-hypothesis multi-agent architecture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "scope",
    "hypotheses",
    "agents",
    "retrieval_policy",
    "grounding_policy",
    "conversation_policy",
    "runtrace_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0-ms2"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "task",
        "dataset",
        "base_model_family"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "const": "ContractNLI NDA review"
        },
        "dataset": {
          "const": "ContractNLI"
        },
        "base_model_family": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implemented_ms2",
        "architectural_ms3"
      ],
      "properties": {
        "implemented_ms2": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "vector_rag",
              "graph_rag",
              "conversation_agent",
              "conversation_history",
              "runtrace_logging"
            ]
          }
        },
        "architectural_ms3": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "description": "The 17 ContractNLI hypothesis-level review outputs planned in the target architecture.",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "agents": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "retrieval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_corpus",
        "allowed_modes",
        "selection_rule",
        "external_context_role"
      ],
      "properties": {
        "training_corpus": {
          "const": "ContractNLI training split"
        },
        "allowed_modes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "vector",
              "graph"
            ]
          }
        },
        "selection_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exactly_one_branch_per_conversation_turn",
            "selector"
          ],
          "properties": {
            "exactly_one_branch_per_conversation_turn": {
              "const": true
            },
            "selector": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "external_context_role": {
          "const": "historical_precedent_only"
        }
      }
    },
    "grounding_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_evidence_source",
        "external_retrieval_allowed_for_reasoning",
        "contract_evidence_required_for_hypothesis_decisions"
      ],
      "properties": {
        "final_evidence_source": {
          "const": "target_contract"
        },
        "external_retrieval_allowed_for_reasoning": {
          "const": true
        },
        "contract_evidence_required_for_hypothesis_decisions": {
          "const": true
        },
        "citation_policy": {
          "type": "string"
        }
      }
    },
    "conversation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_fields",
        "history_format",
        "preserve_history_across_followups"
      ],
      "properties": {
        "input_fields": {
          "type": "array",
          "contains": {
            "const": "contract_text"
          },
          "items": {
            "enum": [
              "contract_text",
              "user_prompt",
              "conversation_history",
              "retrieval_mode"
            ]
          }
        },
        "history_format": {
          "type": "string",
          "minLength": 1
        },
        "preserve_history_across_followups": {
          "const": true
        }
      }
    },
    "runtrace_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_file",
        "required_top_level_fields"
      ],
      "properties": {
        "schema_file": {
          "const": "assets/runtrace_ms2.schema.json"
        },
        "required_top_level_fields": {
          "type": "array",
          "contains": {
            "const": "conversation_history"
          },
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "output_owner_agent",
        "allowed_labels",
        "evidence_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "output_owner_agent": {
          "type": "string",
          "minLength": 1
        },
        "allowed_labels": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Entailment",
              "Contradiction",
              "NotMentioned"
            ]
          }
        },
        "evidence_rule": {
          "const": "final decision evidence must be selected from the target contract"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "implemented_status": {
          "enum": [
            "implemented_ms2",
            "architectural_ms2",
            "planned_ms3"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
